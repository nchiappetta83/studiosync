{
  "name": "sd-scheduling",
  "version": "1.2.0",
  "description": "StudioSync - Collaborative task management",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node ..\\scripts\\smoke-tests.js scheduling",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "exceljs": "^4.4.0",
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "com.studiosync.dashboard",
    "productName": "StudioSync",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/studiosync-main.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "shortcutName": "StudioSync"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "extraResources": [
      {
        "from": "assets/studiosync-main.ico",
        "to": "studiosync-main.ico"
      }
    ],
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*"
    ]
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
