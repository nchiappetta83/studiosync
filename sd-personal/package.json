{
  "name": "sd-personal",
  "version": "1.1.0",
  "description": "StudioSync Personal - local personal task workspace",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node ..\\scripts\\smoke-tests.js companion",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "postinstall": "electron-rebuild"
  },
  "author": "",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.studiosync.personal",
    "productName": "StudioSync Personal",
    "directories": {
      "output": "dist-personal"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/studiosync-mytasks.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "shortcutName": "StudioSync Personal"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "files": [
      "main/**/*",
      "!main/sync.js",
      "!main/updateManager.js",
      "renderer/**/*",
      "assets/**/*"
    ]
  }
}
