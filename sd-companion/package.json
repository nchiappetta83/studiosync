{
  "name": "sd-companion",
  "version": "1.2.0",
  "description": "StudioSync MyTasks - Role-based task viewer",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node ..\\scripts\\smoke-tests.js companion",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "postinstall": "electron-rebuild"
  },
  "author": "",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.studiosync.mytasks",
    "productName": "StudioSync MyTasks",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/studiosync-mytasks.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/studiosync-mytasks.ico",
      "uninstallerIcon": "assets/studiosync-mytasks.ico",
      "installerHeaderIcon": "assets/studiosync-mytasks.ico",
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "shortcutName": "StudioSync MyTasks"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/studiosync-mytasks.ico",
        "to": "assets/studiosync-mytasks.ico"
      }
    ]
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
